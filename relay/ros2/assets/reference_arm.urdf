<?xml version="1.0"?>
<!-- Relay's illustrative 6-axis reference arm. Not a Panda or a dynamics model.
     Joint names/limits match JointProfile; geometry units are meters. -->
<robot name="relay_reference_arm">
  <material name="base"><color rgba="0.15 0.20 0.28 1"/></material>
  <material name="arm"><color rgba="0.30 0.49 0.76 1"/></material>
  <material name="joint"><color rgba="0.18 0.28 0.42 1"/></material>
  <material name="tool"><color rgba="0.95 0.61 0.24 1"/></material>
  <link name="world"/>
  <link name="base_link">
    <visual><origin xyz="0 0 0.04"/><geometry><box size="0.24 0.24 0.08"/></geometry><material name="base"/></visual>
  </link>
  <joint name="world_to_base" type="fixed"><parent link="world"/><child link="base_link"/></joint>

  <link name="shoulder_link">
    <visual><origin xyz="0 0 0.07"/><geometry><cylinder radius="0.065" length="0.14"/></geometry><material name="joint"/></visual>
  </link>
  <joint name="joint1" type="revolute">
    <parent link="base_link"/><child link="shoulder_link"/><origin xyz="0 0 0.08"/><axis xyz="0 0 1"/>
    <limit lower="-1.5" upper="1.5" effort="10" velocity="0.5"/>
  </joint>
  <link name="upper_arm_link">
    <visual><origin xyz="0 0 0.15"/><geometry><box size="0.07 0.08 0.30"/></geometry><material name="arm"/></visual>
  </link>
  <joint name="joint2" type="revolute">
    <parent link="shoulder_link"/><child link="upper_arm_link"/><origin xyz="0 0 0.14"/><axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="10" velocity="0.5"/>
  </joint>
  <link name="forearm_link">
    <visual><origin xyz="0.13 0 0"/><geometry><box size="0.26 0.065 0.065"/></geometry><material name="arm"/></visual>
  </link>
  <joint name="joint3" type="revolute">
    <parent link="upper_arm_link"/><child link="forearm_link"/><origin xyz="0 0 0.30"/><axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="10" velocity="0.5"/>
  </joint>
  <link name="wrist_roll_link">
    <visual><origin xyz="0.035 0 0" rpy="0 1.5707963267948966 0"/><geometry><cylinder radius="0.043" length="0.07"/></geometry><material name="joint"/></visual>
  </link>
  <joint name="joint4" type="revolute">
    <parent link="forearm_link"/><child link="wrist_roll_link"/><origin xyz="0.26 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-1.5" upper="1.5" effort="10" velocity="0.5"/>
  </joint>
  <link name="wrist_pitch_link">
    <visual><origin xyz="0.035 0 0"/><geometry><box size="0.07 0.065 0.065"/></geometry><material name="arm"/></visual>
  </link>
  <joint name="joint5" type="revolute">
    <parent link="wrist_roll_link"/><child link="wrist_pitch_link"/><origin xyz="0.07 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="10" velocity="0.5"/>
  </joint>
  <link name="tool_link">
    <visual><origin xyz="0.035 0 0"/><geometry><box size="0.07 0.12 0.045"/></geometry><material name="tool"/></visual>
  </link>
  <joint name="joint6" type="revolute">
    <parent link="wrist_pitch_link"/><child link="tool_link"/><origin xyz="0.07 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-1.5" upper="1.5" effort="10" velocity="0.5"/>
  </joint>
  <link name="fixed_finger_link">
    <visual><origin xyz="0.045 0 0"/><geometry><box size="0.09 0.015 0.025"/></geometry><material name="tool"/></visual>
  </link>
  <joint name="fixed_finger_mount" type="fixed">
    <parent link="tool_link"/><child link="fixed_finger_link"/><origin xyz="0.05 -0.015 0"/>
  </joint>
  <link name="moving_finger_link">
    <visual><origin xyz="0.045 0 0"/><geometry><box size="0.09 0.015 0.025"/></geometry><material name="tool"/></visual>
  </link>
  <joint name="gripper_joint" type="prismatic">
    <parent link="tool_link"/><child link="moving_finger_link"/><origin xyz="0.05 0.015 0"/><axis xyz="0 1 0"/>
    <limit lower="0" upper="0.04" effort="5" velocity="0.4"/>
  </joint>
</robot>
